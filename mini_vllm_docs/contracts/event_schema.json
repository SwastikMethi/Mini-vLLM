{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mini-vllm:event:v1",
  "title": "Mini vLLM engine event",
  "description": "R0 contract. Transport reset and heartbeat records are not persisted engine events.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "engine.ready",
        "request.accepted",
        "request.tokenization.started",
        "request.tokenized",
        "request.queued",
        "request.admitted",
        "cache.allocated",
        "batch.scheduled",
        "batch.started",
        "batch.completed",
        "batch.failed",
        "request.prefill.started",
        "request.prefill.completed",
        "request.decode.started",
        "request.decode.completed",
        "token.sampled",
        "request.cancel_requested",
        "cache.released",
        "request.terminal",
        "engine.failed"
      ]
    },
    "monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "wall_time": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "engine"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "batch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "seq",
    "type",
    "monotonic_ns",
    "wall_time",
    "source",
    "request_id",
    "batch_id",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "engine.ready"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "model_id": {
                "type": "string"
              },
              "model_revision": {
                "type": "string"
              },
              "device": {
                "type": "string"
              },
              "dtype": {
                "type": "string"
              },
              "block_size": {
                "type": "integer",
                "minimum": 1
              },
              "pool_blocks": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "model_id",
              "model_revision",
              "device",
              "dtype",
              "block_size",
              "pool_blocks"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "null"
          },
          "batch_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.accepted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string"
              },
              "max_new_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "temperature": {
                "type": "number",
                "minimum": 0
              },
              "seed": {
                "type": "integer",
                "minimum": 0
              },
              "client_request_id": {
                "type": "string"
              },
              "deadline_ms": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "prompt",
              "max_new_tokens",
              "temperature",
              "seed",
              "client_request_id",
              "deadline_ms"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.tokenization.started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.tokenized"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "prompt_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "tokenizer_revision": {
                "type": "string"
              },
              "template_id": {
                "type": "string"
              }
            },
            "required": [
              "prompt_tokens",
              "tokenizer_revision",
              "template_id"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.queued"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "awaiting_scheduler",
                  "capacity",
                  "active_limit"
                ]
              },
              "position": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "reason",
              "position"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.admitted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "reservation_blocks": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "reservation_blocks"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "cache.allocated"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "mappings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "logical_block": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "physical_block": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "logical_block",
                    "physical_block"
                  ],
                  "additionalProperties": false
                }
              },
              "reason": {
                "type": "string",
                "enum": [
                  "prefill",
                  "decode_growth"
                ]
              }
            },
            "required": [
              "mappings",
              "reason"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "batch.scheduled"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "prefill",
                  "decode"
                ]
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "request_id": {
                      "type": "string"
                    },
                    "input_tokens": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "start_position": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "request_id",
                    "input_tokens",
                    "start_position"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "phase",
              "members"
            ],
            "additionalProperties": false
          },
          "batch_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "batch.started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "prefill",
                  "decode"
                ]
              }
            },
            "required": [
              "phase"
            ],
            "additionalProperties": false
          },
          "batch_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "batch.completed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "prefill",
                  "decode"
                ]
              },
              "host_duration_ms": {
                "type": "number",
                "minimum": 0
              },
              "gpu_duration_ms": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "phase",
              "host_duration_ms",
              "gpu_duration_ms"
            ],
            "additionalProperties": false
          },
          "batch_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "batch.failed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "prefill",
                  "decode"
                ]
              },
              "error_code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "phase",
              "error_code",
              "message"
            ],
            "additionalProperties": false
          },
          "batch_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.prefill.started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "cached_prefix_tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "input_tokens",
              "cached_prefix_tokens"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          },
          "batch_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.prefill.completed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "processed_tokens": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "processed_tokens"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          },
          "batch_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.decode.started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "decode_step": {
                "type": "integer",
                "minimum": 1
              },
              "input_position": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "decode_step",
              "input_position"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          },
          "batch_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.decode.completed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "decode_step": {
                "type": "integer",
                "minimum": 1
              },
              "processed_tokens": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "decode_step",
              "processed_tokens"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          },
          "batch_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "token.sampled"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "token_index": {
                "type": "integer",
                "minimum": 0
              },
              "token_id": {
                "type": "integer",
                "minimum": 0
              },
              "text_delta": {
                "type": "string"
              },
              "generated_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "processed_tokens": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "token_index",
              "token_id",
              "text_delta",
              "generated_tokens",
              "processed_tokens"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.cancel_requested"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "user",
                  "deadline"
                ]
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "cache.released"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "physical_blocks": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "reservation_blocks": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "enum": [
                  "completed",
                  "cancelled",
                  "failed"
                ]
              }
            },
            "required": [
              "physical_blocks",
              "reservation_blocks",
              "reason"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "request.terminal"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "completed",
                  "cancelled",
                  "failed"
                ]
              },
              "stop_reason": {
                "type": "string",
                "enum": [
                  "eos",
                  "length",
                  "user",
                  "deadline",
                  "engine_error",
                  "storage_error"
                ]
              },
              "generated_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "processed_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "final_output_text": {
                "type": "string"
              },
              "error_code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "status",
              "stop_reason",
              "generated_tokens",
              "processed_tokens",
              "final_output_text",
              "error_code"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "engine.failed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "error_code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "trace_complete": {
                "type": "boolean"
              }
            },
            "required": [
              "error_code",
              "message",
              "trace_complete"
            ],
            "additionalProperties": false
          },
          "request_id": {
            "type": "null"
          },
          "batch_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
